# Copy to .env and adjust. Used by docker compose for local deployment.

# MySQL
DB_PASSWORD=123123
# Host port for MySQL. Change to 3307 if you already run a local MySQL on 3306.
DB_PORT=3306

# JWT - use a long random string (>= 32 chars)
JWT_SECRET=replace_this_with_a_long_random_base64_string_at_least_256_bits_for_hs256
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# First admin account created on startup (only if no admin exists)
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=Admin@12345

# Email notifications (SMTP). Mailtrap defaults; set your inbox credentials.
NOTIFICATIONS_ENABLED=true
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Rate limiting store: memory (default) or redis (distributed across replicas)
RATE_LIMIT_STORE=redis
RATE_LIMIT_ENABLED=false

# Redis (used when RATE_LIMIT_STORE=redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Fail the /actuator/health checks when Redis is unreachable? false (default):
# Redis is optional and the rate limiter fails open, so don't mark the pod DOWN.
# Set to true when the app must not run without Redis.
REDIS_HEALTH_ENABLED=false
